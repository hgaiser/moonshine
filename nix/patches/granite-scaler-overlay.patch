 const bool DITHER = (CONTROL & CONTROL_DITHER_BIT) != 0;
+const bool OVERLAY = (CONTROL & CONTROL_OVERLAY_BIT) != 0;
 
 const int TRANSFER_IDENTITY = 0;
 const int TRANSFER_SRGB = 1;
@@ -62,6 +64,10 @@ layout(set = 0, binding = 4) uniform UBO
 
 layout(set = 0, binding = 5) writeonly uniform mediump image2D uChromaPlane2;
 layout(set = 0, binding = 6) writeonly uniform mediump image2D uChromaPlane3;
+// Up to two premultiplied layers composited 1:1 over the input, bottom to
+// top, before any transfer function, as a compositor blends into its output.
+layout(set = 0, binding = 7) uniform mediump texture2D uOverlay0;
+layout(set = 0, binding = 8) uniform mediump texture2D uOverlay1;
 
 ivec2 unswizzle8x8(uint index)
 {
@@ -85,10 +91,41 @@ layout(push_constant) uniform Registers
     vec2 crop_bias;
     vec2 crop_scale;
     float dither_strength;
+    // Per layer: offset.xy and size.zw in input texels; zero size disables.
+    ivec4 overlay_rect[2];
+    // Element alpha per layer (compositor opacity).
+    vec2 overlay_opacity;
+    // Non-zero: ignore the texel alpha (X formats).
+    uvec2 overlay_opaque;
 } registers;
 
 #include "../inc/srgb.h"
 
+f16vec4 blend_overlay(f16vec4 v, ivec2 input_coord, int i)
+{
+    ivec4 rect = registers.overlay_rect[i];
+    ivec2 rel = input_coord - rect.xy;
+    if (any(lessThan(rel, ivec2(0))) || any(greaterThanEqual(rel, rect.zw)))
+        return v;
+    f16vec4 o = f16vec4(i == 0 ? texelFetch(uOverlay0, rel, 0) : texelFetch(uOverlay1, rel, 0));
+    if (registers.overlay_opaque[i] != 0u)
+        o.a = float16_t(1.0);
+    // A compositor draws texel * element alpha, blended ONE, ONE_MINUS_SRC_ALPHA.
+    o *= float16_t(registers.overlay_opacity[i]);
+    v.rgb = o.rgb + v.rgb * (float16_t(1.0) - o.a);
+    return v;
+}
+
+f16vec4 apply_overlay(f16vec4 v, ivec2 input_coord)
+{
+    if (OVERLAY)
+    {
+        v = blend_overlay(v, input_coord, 0);
+        v = blend_overlay(v, input_coord, 1);
+    }
+    return v;
+}
+
 f16vec4 apply_eotf(f16vec4 v)
 {
     if (EOTF == TRANSFER_SRGB)
@@ -274,6 +311,8 @@ void main()
         else
         {
             final_result = f16vec4(texelFetch(uTexture, coord + registers.crop_offset, 0));
+            // The host only enables overlays for unsampled 1:1 input.
+            final_result = apply_overlay(final_result, coord + registers.crop_offset);
         }
 
         final_result = apply_eotf(final_result);
