+// Premultiplied overlay composited 1:1 over the input before any transfer
+// function, as a compositor blends into its output buffer.
+layout(set = 0, binding = 7) uniform mediump texture2D uOverlay;
 
 ivec2 unswizzle8x8(uint index)
 {
@@ -85,10 +90,26 @@ layout(push_constant) uniform Registers
     vec2 crop_bias;
     vec2 crop_scale;
     float dither_strength;
+    ivec2 overlay_offset;
+    ivec2 overlay_size;
 } registers;
 
 #include "../inc/srgb.h"
 
+f16vec4 apply_overlay(f16vec4 v, ivec2 input_coord)
+{
+    if (OVERLAY)
+    {
+        ivec2 rel = input_coord - registers.overlay_offset;
+        if (all(greaterThanEqual(rel, ivec2(0))) && all(lessThan(rel, registers.overlay_size)))
+        {
+            f16vec4 o = f16vec4(texelFetch(uOverlay, rel, 0));
+            v.rgb = o.rgb + v.rgb * (float16_t(1.0) - o.a);
+        }
+    }
+    return v;
+}
