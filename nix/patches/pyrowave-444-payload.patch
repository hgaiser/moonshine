diff --git a/pyrowave_encoder.cpp b/pyrowave_encoder.cpp
index 1f84184..1b8128c 100644
--- a/pyrowave_encoder.cpp
+++ b/pyrowave_encoder.cpp
@@ -191,8 +191,11 @@ void Encoder::Impl::init_block_meta()
 	meta_buffer = device->create_buffer(info);
 	device->set_name(*meta_buffer, "meta-buffer");
 
-	// Worst case estimate.
-	info.size = aligned_width * aligned_height * 2;
+	// 4:4:4 has twice the coefficient samples of 4:2:0. The temporary
+	// payload is written before rate control, so the final budget cannot
+	// protect an undersized allocation. Promote before multiplying.
+	info.size = VkDeviceSize(aligned_width) * aligned_height *
+	            (chroma == ChromaSubsampling::Chroma444 ? 4 : 2);
 	payload_data = device->create_buffer(info);
 	device->set_name(*payload_data, "payload-data");
 
